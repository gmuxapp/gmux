---
import heroDesktop from '../assets/hero-desktop.png'
import heroMobile from '../assets/hero-mobile.png'
import piLogo from '../assets/agent-logos/pi.svg?url'
import anthropicLogo from '../assets/agent-logos/anthropic.svg?url'
import openaiLogo from '../assets/agent-logos/openai.svg?url'
import PostHog from '../components/posthog.astro'
import Topology from '../components/Topology.astro'
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <PostHog />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>gmux — the control plane for AI agents</title>
  <meta name="description" content="The control plane for AI agents. Run pi, Claude Code, Codex, and other coding agents wherever your work lives. Humans and agents start, watch, steer, and delegate from one place." />
  <meta property="og:title" content="gmux — the control plane for AI agents" />
  <meta property="og:description" content="The control plane for AI agents. Run pi, Claude Code, Codex, and other coding agents wherever your work lives. Humans and agents start, watch, steer, and delegate from one place." />
  <meta property="og:image" content="https://gmux.app/og.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://gmux.app" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://gmux.app/og.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <!-- Nav -->
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">gmux</a>
      <div class="nav-links">
        <a href="/getting-started/">Docs</a>
        <a href="https://discord.gg/Mg6EJHFZxu" class="nav-icon" aria-label="Discord">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.32 4.37a19.8 19.8 0 0 0-4.93-1.51 13.78 13.78 0 0 0-.64 1.28 18.27 18.27 0 0 0-5.5 0 12.64 12.64 0 0 0-.64-1.28h-.05A19.74 19.74 0 0 0 3.64 4.4 20.26 20.26 0 0 0 .11 18.09l.02.02a19.9 19.9 0 0 0 6.04 3.03l.04-.02a14.24 14.24 0 0 0 1.23-2.03.08.08 0 0 0-.05-.07 13.1 13.1 0 0 1-1.9-.92.08.08 0 0 1 .02-.1 10.2 10.2 0 0 0 .41-.31h.04a14.2 14.2 0 0 0 12.1 0l.04.01a9.63 9.63 0 0 0 .4.32.08.08 0 0 1-.03.1 12.29 12.29 0 0 1-1.9.91.08.08 0 0 0-.02.1 15.97 15.97 0 0 0 1.27 2.01h.04a19.84 19.84 0 0 0 6.03-3.05v-.03a20.12 20.12 0 0 0-3.57-13.69ZM8.02 15.33c-1.18 0-2.16-1.08-2.16-2.42 0-1.33.96-2.42 2.16-2.42 1.21 0 2.18 1.1 2.16 2.42 0 1.34-.96 2.42-2.16 2.42Zm7.97 0c-1.18 0-2.15-1.08-2.15-2.42 0-1.33.95-2.42 2.15-2.42 1.22 0 2.18 1.1 2.16 2.42 0 1.34-.94 2.42-2.16 2.42Z"/></svg>
        </a>
        <a href="https://github.com/gmuxapp/gmux" class="nav-icon" aria-label="GitHub">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-content">
      <div class="hero-text">
        <div class="hero-copy">
          <h1>The control plane<br />for AI agents.</h1>
          <p class="hero-sub">
            Scale what you can do, not what you have to supervise.
            Gmux lets agents carry work forward while keeping control within reach.
          </p>
        </div>
        <div class="hero-controls">
          <div class="hero-install">
            <div class="install-box">
              <div class="install-tabs" id="install-tabs" aria-label="Install method">
                <button class="tab-btn active" data-os="mac" aria-pressed="true">macOS</button>
                <button class="tab-btn" data-os="linux" aria-pressed="false">Linux</button>
                <a class="script-link" href="/install.sh">What does this script do?</a>
              </div>
              <div class="install-cmd" id="install-cmd">
                <code data-cmd-mac="brew install gmuxapp/tap/gmux" data-cmd-linux="curl -sSfL https://gmux.app/install.sh | sh">brew install gmuxapp/tap/gmux</code>
                <span class="visually-hidden" id="copy-status" aria-live="polite"></span>
                <button class="copy-btn" id="copy-btn" aria-label="Copy to clipboard">
                  <svg class="copy-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                  <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:none"><polyline points="20 6 9 17 4 12"/></svg>
                </button>
              </div>
            </div>
          </div>
          <div class="hero-actions">
            <a href="/getting-started/" class="hero-cta">Get started</a>
            <a href="https://github.com/gmuxapp/gmux" class="hero-secondary">Source on GitHub</a>
          </div>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="hero-stage">
          <img
            class="hero-desktop-shot"
            src={heroDesktop.src}
            alt=""
            width={heroDesktop.width}
            height={heroDesktop.height}
            loading="eager"
            fetchpriority="high"
          />
          <img
            class="hero-mobile-shot"
            src={heroMobile.src}
            alt=""
            width={heroMobile.width}
            height={heroMobile.height}
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Agent orchestration -->
  <section class="section orchestration-section">
    <div class="section-inner orchestration-layout">
      <div class="orchestration-copy">
        <h2>Humans control agents.<br />Agents do the same.</h2>
        <p class="orchestration-note">Parallel delegation is easy for agents to drive, and just as easy for you to watch, steer, or take over.</p>
      </div>
      <div class="cli-example" role="img" aria-label="A primary agent starting and waiting for two review agents">
        <div class="cli-step">
          <code class="cli-command-line"><span class="cli-shell" aria-hidden="true">›</span> <span class="cli-command">gmux agent prompt</span> <span class="cli-flag">--new</span> <span class="cli-flag">--no-wait</span> <span class="cli-flag">--model</span> <span class="cli-model">fable-5</span> <span class="cli-slash">\</span></code>
          <code class="cli-prompt-text">'Review the design.'</code>
          <samp>f7m2k9c4</samp>
        </div>
        <div class="cli-step">
          <code class="cli-command-line"><span class="cli-shell" aria-hidden="true">›</span> <span class="cli-command">gmux agent prompt</span> <span class="cli-flag">--new</span> <span class="cli-flag">--no-wait</span> <span class="cli-flag">--model</span> <span class="cli-model">gpt-5.6-luna</span> <span class="cli-slash">\</span></code>
          <code class="cli-prompt-text">'Audit the tests.'</code>
          <samp>l6q8d2n5</samp>
        </div>
        <div class="cli-step">
          <code class="cli-command-line"><span class="cli-shell" aria-hidden="true">›</span> <span class="cli-command">gmux wait</span> <span class="cli-id-ref">f7m2k9c4 l6q8d2n5</span></code>
        </div>
      </div>
    </div>
  </section>

  <!-- Agent choice -->
  <section class="section harness-section">
    <div class="section-inner harness-layout">
      <div>
        <h2>The best agent keeps changing.<br />The way you work <span class="no-wrap">shouldn’t have to.</span></h2>
        <p class="section-lead">Use different coding agents side by side. Stay in control while choosing the best one for each job.</p>
      </div>
      <div class="harness-brands" aria-label="Supported coding agents">
        <div><img src={piLogo} alt="" /><span>pi</span></div>
        <div><img src={anthropicLogo} alt="" /><span>Claude Code</span></div>
        <div><img src={openaiLogo} alt="" /><span>Codex</span></div>
        <p>…all powered by the <span class="no-wrap">same extensible adapter system.</span></p>
      </div>
    </div>
  </section>

  <!-- Topology -->
  <section class="section topology-section">
    <div class="section-inner">
      <div class="topology-copy">
        <h2>Agents run where you need them.</h2>
        <p class="section-lead">Local machine, isolated container, always-on server. Gmux keeps location incidental, so you can choose the best fit for each use case.</p>
      </div>
      <Topology />
      <div class="remote-strip">
        <span class="remote-strip-label">Already use Tailscale?</span>
        <span>Run <code>gmux remote</code> once and you won’t need to open any ports. <a href="/remote-access/">Learn more</a></span>
      </div>
    </div>
  </section>

  <!-- Attention-aware notifications -->
  <section class="section continuity-section">
    <div class="section-inner continuity">
      <h2>Know when an agent needs input.</h2>
      <div class="contrast">
        <div class="contrast-panel">
          <div class="contrast-label">without Gmux</div>
          <p class="contrast-line">Check each session manually.<br />See whether an agent is waiting.</p>
        </div>
        <div class="contrast-arrow" aria-hidden="true">&rarr;</div>
        <div class="contrast-panel contrast-panel-accent">
          <div class="contrast-label">with Gmux</div>
          <p class="contrast-line">Gmux notifies you when a response is needed.</p>
          <div class="mock-notif">
            <div class="mock-notif-header">
              <span class="mock-notif-app">
                <svg class="mock-notif-icon" viewBox="0 0 32 32" width="18" height="18" aria-hidden="true">
                  <rect width="32" height="32" rx="6" fill="#0f141a"/>
                  <rect x="3.5" y="3.5" width="25" height="25" rx="3.5" fill="none" stroke="#49b8b8" stroke-width="1.5"/>
                  <polyline points="8,10 16,16 8,22" fill="none" stroke="#49b8b8" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                  <line x1="18" y1="22" x2="25" y2="22" stroke="#49b8b8" stroke-width="2.4" stroke-linecap="round"/>
                </svg>
                <span>gmux</span>
              </span>
              <span class="mock-notif-time">now</span>
            </div>
            <div class="mock-notif-title">codex · refactor adapters</div>
            <div class="mock-notif-body">Needs your input.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="section cta-section">
    <div class="section-inner cta-inner">
      <h2>Open source. Local-first. Built around your tools.</h2>
      <p>Get started in minutes.</p>
      <a href="/getting-started/" class="hero-cta">Get started</a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="footer-inner">
      <span class="footer-logo">gmux</span>
      <div class="footer-links">
        <a href="/getting-started/">Docs</a>
        <a href="https://github.com/gmuxapp/gmux">GitHub</a>
        <a href="https://discord.gg/Mg6EJHFZxu">Discord</a>
        <span class="footer-sep">&middot;</span>
        <span class="footer-license">MIT License</span>
      </div>
      <div class="footer-socials">
        <a href="https://bsky.app/profile/mgabor.hu" aria-label="Bluesky" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 568 501" fill="currentColor"><path d="M123.121 33.664C188.241 82.553 258.281 181.68 284 234.873c25.719-53.192 95.759-152.32 160.879-201.21C491.866-1.611 568-28.906 568 57.947c0 17.346-9.945 145.713-15.778 166.555-20.275 72.453-94.155 90.933-159.875 79.748C507.222 323.8 536.444 388.56 473.333 453.32c-119.86 122.992-172.272-30.859-185.702-70.281-2.462-7.227-3.614-10.608-3.631-7.733-.017-2.875-1.169.506-3.631 7.733-13.43 39.422-65.842 193.273-185.702 70.281-63.111-64.76-33.889-129.52 80.986-149.071-65.72 11.185-139.6-7.295-159.875-79.748C9.945 203.659 0 75.291 0 57.946 0-28.906 76.135-1.612 123.121 33.664Z"/></svg>
        </a>
        <a href="https://x.com/mgabor_" aria-label="X" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="https://ko-fi.com/mgabor" aria-label="Ko-fi" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.723c-.604 0-.679.798-.679.798s-.082 7.324-.022 11.822c.164 2.424 2.586 2.672 2.586 2.672s8.267-.023 11.966-.049c2.438-.426 2.683-2.566 2.658-3.734 4.352.24 7.422-2.831 6.649-6.916zm-11.062 3.511c-1.246 1.453-4.011 3.976-4.011 3.976s-.121.119-.31.023c-.076-.057-.108-.09-.108-.09-.443-.441-3.368-3.049-4.034-3.954-.709-.965-1.041-2.7-.091-3.71.951-1.01 3.005-1.086 4.363.407 0 0 1.565-1.782 3.468-.963 1.904.82 1.832 3.011.723 4.311zm6.173.478c-.928.116-1.682.028-1.682.028V7.284h1.77s1.971.551 1.971 2.638c0 1.913-.985 2.667-2.059 3.015z"/></svg>
        </a>
      </div>
    </div>
  </footer>

  <script>
    const commands = {
      mac: 'brew install gmuxapp/tap/gmux',
      linux: 'curl -sSfL https://gmux.app/install.sh | sh',
    }

    // Detect OS from user agent
    function detectOS() {
      const ua = navigator.userAgent || navigator.platform || ''
      if (/Linux/.test(ua) && !/Android/.test(ua)) return 'linux'
      return 'mac'
    }

    // Switch all tab groups to a given OS
    function switchOS(os) {
      document.querySelectorAll('.install-tabs').forEach(tabs => {
        tabs.querySelectorAll('.tab-btn').forEach(btn => {
          const active = btn.dataset.os === os
          btn.classList.toggle('active', active)
          btn.setAttribute('aria-pressed', String(active))
        })
      })
      document.querySelectorAll('.install-cmd code[data-cmd-mac]').forEach(code => {
        code.textContent = commands[os]
      })
      document.querySelectorAll('.script-link').forEach(link => {
        link.style.visibility = os === 'linux' ? 'visible' : 'hidden'
      })
    }

    // Reorder tabs so the detected OS comes first
    function reorderTabs(os) {
      document.querySelectorAll('.install-tabs').forEach(tabs => {
        const btns = [...tabs.querySelectorAll('.tab-btn')]
        const first = btns.find(b => b.dataset.os === os)
        if (first && first !== btns[0]) {
          tabs.insertBefore(first, btns[0])
        }
      })
    }

    // Wire up tab clicks (synced across both tab groups)
    document.querySelectorAll('.install-tabs .tab-btn').forEach(btn => {
      btn.addEventListener('click', () => switchOS(btn.dataset.os))
    })

    // Copy button
    function setupCopyBtn(id) {
      const btn = document.getElementById(id)
      if (!btn) return
      btn.addEventListener('click', () => {
        const code = btn.closest('.install-cmd').querySelector('code')
        navigator.clipboard.writeText(code.textContent)
        const status = document.getElementById('copy-status')
        if (status) status.textContent = 'Copied to clipboard'
        const copy = btn.querySelector('.copy-icon')
        const check = btn.querySelector('.check-icon')
        if (copy && check) {
          copy.style.display = 'none'
          check.style.display = 'block'
          setTimeout(() => {
            copy.style.display = 'block'
            check.style.display = 'none'
            if (status) status.textContent = ''
          }, 2000)
        }
      })
    }
    setupCopyBtn('copy-btn')

    // Auto-detect on load
    const detected = detectOS()
    reorderTabs(detected)
    switchOS(detected)

    // Reveal after OS detection to avoid flash of wrong command
    document.querySelectorAll('.install-box').forEach(box => {
      box.classList.add('ready')
    })
  </script>
</body>
</html>

<style>
  :where(*, *::before, *::after) {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --bg: oklch(12% 0.015 250);
    --bg-alt: oklch(15% 0.015 250);
    --text: oklch(88% 0.01 250);
    --text-secondary: oklch(65% 0.01 250);
    --text-muted: oklch(48% 0.01 250);
    --accent: oklch(72% 0.1 195);
    --border: oklch(22% 0.015 250);
    --border-subtle: oklch(18% 0.01 250);
    --code-bg: oklch(16% 0.015 250);
    --font-display: 'Instrument Sans', sans-serif;
    --font-body: 'Source Sans 3', 'Segoe UI', system-ui, sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
    --surface-raised: oklch(18% 0.015 250);
    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --page-shell: 1180px;
    --page-gutter: 2.5rem;
    --section-space: 5rem;
  }

  html {
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    font-family: var(--font-body);
    color: var(--text);
    background: var(--bg);
    line-height: 1.6;
    /* inherited: keeps prose free of single-word last lines */
    text-wrap: pretty;
  }

  h1, h2, h3 {
    font-family: var(--font-display);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--text);
    background: oklch(21% 0.015 250);
    border: 1px solid var(--border);
    padding: 0.1em 0.4em;
    border-radius: 4px;
  }

  .nav-inner,
  .hero-content,
  .section-inner,
  .footer-inner {
    max-width: var(--page-shell);
    margin-inline: auto;
    padding-inline: var(--page-gutter);
  }

  /* --- Nav --- */
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: oklch(12% 0.015 250 / 0.85);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .nav-inner {
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    color: var(--text);
    letter-spacing: -0.04em;
  }
  .nav-logo:hover { text-decoration: none; }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav-links a {
    color: var(--text-secondary);
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.15s;
  }
  .nav-links a:hover { color: var(--text); text-decoration: none; }

  .nav-icon { display: flex; align-items: center; color: var(--text-muted) !important; }
  .nav-icon:hover { color: var(--text) !important; }

  /* --- Hero --- */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 5.5rem 0;
    background:
      radial-gradient(
        ellipse 48% 115% at 74% 46%,
        oklch(49% 0.095 195 / 0.2),
        transparent 68%
      ),
      radial-gradient(
        ellipse 34% 75% at 88% 85%,
        oklch(34% 0.055 225 / 0.13),
        transparent 72%
      ),
      linear-gradient(
        180deg,
        oklch(15.5% 0.018 250),
        oklch(13.5% 0.016 250)
      );
    border-bottom: 1px solid color-mix(in oklch, var(--accent) 15%, var(--border-subtle));
  }

  .hero::after {
    content: '';
    position: absolute;
    z-index: -1;
    left: 15%;
    right: 5%;
    bottom: -1px;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      oklch(60% 0.08 195 / 0.16) 55%,
      transparent
    );
  }

  .hero-content {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1.15fr);
    gap: 4rem;
    align-items: center;
  }

  .hero-text {
    max-width: 40rem;
  }

  .hero h1 {
    font-size: 3.25rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1.25rem;
